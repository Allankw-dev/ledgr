# Supabase Postgres — Session pooler URI (port 5432) works well with SQLAlchemy
# This is the "postgres" role — owns the tables, used for migrations.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# The restricted "ledgr_app" role created by sql/enable_rls.sql — used to
# actually serve requests, so Row-Level Security policies apply. Same host,
# different username/password. Leave unset and the app still runs, but
# without the RLS second wall (falls back to DATABASE_URL).
APP_DATABASE_URL="postgresql://ledgr_app:[APP_ROLE_PASSWORD]@[HOST]:5432/postgres"

JWT_SECRET="replace-with-a-long-random-string"
JWT_ALGORITHM="HS256"
JWT_EXPIRES_MINUTES=10080

CORS_ORIGINS="http://localhost:5173"

# Phase 2 — M-Pesa Daraja
