# Fee reminders — email via SMTP (any provider; Gmail needs an "app
# password", not your normal password — generate one at
# myaccount.google.com/apppasswords). SMS via Africa's Talking
# (africastalking.com) — sandbox username is literally "sandbox", get a
# sandbox API key free after signing up, no payment needed for testing.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USERNAME="youraddress@gmail.com"
# SMTP_PASSWORD="your-16-char-app-password"
# SMTP_FROM_EMAIL="youraddress@gmail.com"
# SMTP_FROM_NAME="Greenfield Academy"

# AFRICASTALKING_USERNAME="sandbox"
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_SANDBOX=true

# ---- Scale & reliability (all optional — defaults are fine for local dev) ----
# Shared rate-limit counters across workers/instances (Upstash, Redis Cloud, etc).
# REDIS_URL="redis://default:password@host:6379"
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# SYSTEM_DB_POOL_SIZE=2
# SYSTEM_DB_MAX_OVERFLOW=3
# THREADPOOL_SIZE=80
# BACKGROUND_WORKERS=8
# RUN_SCHEDULER=true        # false = don't schedule the daily reminder sweep on this instance
# SENTRY_DSN=
# ENVIRONMENT="production"
# Server-level (read by run.py / gunicorn_conf.py, not by the app itself):
# PORT=4000
# WEB_CONCURRENCY=4
# FORWARDED_ALLOW_IPS="*"   # production behind a proxy/load balancer — see gunicorn_conf.py
